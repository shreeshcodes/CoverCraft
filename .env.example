# ---- AI provider ----
# Required: your Groq API key (free key from https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: override the model used for generation (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# ---- Sign-in (Auth.js) ----
# Required: random secret that signs session cookies.
# Generate one in PowerShell (see the README), then paste it here.
AUTH_SECRET=

# Google: https://console.cloud.google.com/apis/credentials
#   Create an OAuth client ID of type "Web application".
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# LinkedIn: https://www.linkedin.com/developers/apps
#   Add the product "Sign In with LinkedIn using OpenID Connect".
#   Authorized redirect URL: http://localhost:3000/api/auth/callback/linkedin
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# Only needed once the app is deployed, set to its public address:
# AUTH_URL=https://your-domain.example
