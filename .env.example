# ---- AI provider ----
# Required: your Groq API key (free key from https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: override the model used for generation (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# ---- Sign-in (Clerk) ----
# From the Clerk dashboard, API Keys page (development instance keys start with pk_test_ / sk_test_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
